# Copy to .env and adjust as needed.
#
# IMPORTANT: do NOT use inline comments (after the value on the same line).
# pydantic-settings does not strip them, so a line like
#     DATA_DIR=                              # vacio = ./data
# parses as DATA_DIR = "# vacio = ./data" and breaks the app.
# Always put comments on their own line above the variable.

# URL que el totem mostrara en Chrome kiosko.
KIOSK_URL=https://app.rdx.social

# Intervalos (en segundos).
# Cada 15 min toma un screenshot.
SCREENSHOT_INTERVAL_SECONDS=900
# Cada 30s el watchdog verifica que Chrome este vivo.
WATCHDOG_INTERVAL_SECONDS=30
# Cada 1h corre la limpieza de capturas viejas.
RETENTION_INTERVAL_SECONDS=3600
# Si no hay heartbeat hace 15 min, el totem se marca offline en el panel.
OFFLINE_THRESHOLD_SECONDS=900

# Captura: que monitor capturar.
#   primary  -> solo el monitor principal (default, donde abre Chrome).
#   all      -> todos los monitores combinados en una sola imagen panoramica.
#   1, 2, .. -> un monitor especifico (1 = primario, 2 = secundario).
SCREENSHOT_MONITOR=primary

# Retencion.
# Detalle completo: ultimas 24h.
RETENTION_HOURS_FULL=24
# Despues de 24h, conservar 1 captura por dia como archivo permanente.
KEEP_DAILY_ARCHIVE=true

# Servidor.
HOST=0.0.0.0
PORT=8000

# Chrome.
# Vacio = autodetect (rutas estandar de Windows / macOS / Linux).
CHROME_PATH=
# Vacio = default (data/chrome-profile).
CHROME_USER_DATA_DIR=

# Almacenamiento.
# Vacio = ./data (relativo a la carpeta de instalacion).
DATA_DIR=

# Totem.
# Vacio = hostname.
TOTEM_NAME=
TOTEM_LOCATION=Sin especificar

# Zona horaria para mostrar timestamps en el panel.
DISPLAY_TIMEZONE=America/Santiago

# ngrok local API (introspeccion).
NGROK_LOCAL_API=http://localhost:4040

# Panel auth (HTTP Basic).
# Si PANEL_PASSWORD esta vacio, el panel queda abierto (modo dev).
# En produccion/ngrok, definir un password fuerte y reiniciar el servicio.
PANEL_USERNAME=admin
PANEL_PASSWORD=
