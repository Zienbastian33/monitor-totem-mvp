# Copy to .env and adjust as needed.

# URL que el tótem mostrará en Chrome kiosko.
KIOSK_URL=https://app.rdx.social

# Intervalos (en segundos).
SCREENSHOT_INTERVAL_SECONDS=900        # 15 min
WATCHDOG_INTERVAL_SECONDS=30           # cada 30s revisa que Chrome esté vivo
RETENTION_INTERVAL_SECONDS=3600        # cada 1h corre limpieza
OFFLINE_THRESHOLD_SECONDS=900          # si no hay heartbeat hace 15 min, offline

# Captura: qué monitor capturar.
#   primary  → sólo el monitor principal (default, donde abre Chrome).
#   all      → todos los monitores combinados en una sola imagen panorámica.
#   1, 2, …  → un monitor específico (1 = primario, 2 = secundario).
SCREENSHOT_MONITOR=primary

# Retención.
RETENTION_HOURS_FULL=24                # detalle completo: últimas 24h
KEEP_DAILY_ARCHIVE=true                # después de 24h, conservar 1 por día

# Servidor.
HOST=0.0.0.0
PORT=8000

# Chrome.
CHROME_PATH=                           # vacío = autodetect
CHROME_USER_DATA_DIR=                  # vacío = default (data/chrome-profile)

# Almacenamiento.
DATA_DIR=                              # vacío = ./data

# Tótem.
TOTEM_NAME=                            # vacío = hostname
TOTEM_LOCATION=Sin especificar

# Zona horaria para mostrar timestamps en el panel.
DISPLAY_TIMEZONE=America/Santiago

# ngrok local API (introspección).
NGROK_LOCAL_API=http://localhost:4040

# Panel auth (HTTP Basic).
# Si PANEL_PASSWORD está vacío, el panel queda abierto (modo dev).
# En producción/ngrok, definir un password fuerte y reiniciar el servicio.
PANEL_USERNAME=admin
PANEL_PASSWORD=
